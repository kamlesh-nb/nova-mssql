// The MSSQL/TDS driver's wire CODEC (data/sql/mssql.nova) — gated OFFLINE over hand-built
// byte buffers, no server. Covers: the LOGIN7 password obfuscation (nibble-swap + XOR 0xA5,
// UTF-16LE), the PRELOGIN encryption advertisement, and a COLMETADATA/ROW/DONE token-stream
// decode into typed DbValues (INT via INTN, NVARCHAR unicode, NUMERIC exact decimal).
import codec;
import auth;
import db;
import bytes;
import list;
import string;
import assert;

// Build a binary Nova string from a list of byte values.
fn hx(vals: List<int>): string {
    let n = vals.size();
    if (n == 0) { return ""; }
    let p = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(p, i, (vals.get(i) ?? 0) & 255); i = i + 1; }
    return p as string;
}
fn push(l: List<int>, v: int): void { l.push(v); }

@test
fn test_password_obfuscation(): void {
    // reference vector: obf("test") = E2 A5 F3 A5 92 A5 E2 A5  (verified vs a Python impl)
    let o = auth.obfuscatePassword("test");
    assert.equalInt(o.length, 8);
    assert.equalInt(o[0] & 255, 226);  // E2
    assert.equalInt(o[1] & 255, 165);  // A5
    assert.equalInt(o[2] & 255, 243);  // F3
    assert.equalInt(o[3] & 255, 165);  // A5
    assert.equalInt(o[4] & 255, 146);  // 92
    assert.equalInt(o[7] & 255, 165);  // A5
}

@test
fn test_prelogin_advertises_not_sup(): void {
    let pre = codec.buildPrelogin(false);
    // option table: VERSION(0)+ENCRYPTION(1)+THREADID(3)+terminator(0xFF) = 16 bytes, then data.
    // ENCRYPTION option entry is at bytes [5..10): token=1, then be16 offset, be16 len=1.
    assert.equalInt(pre[5] & 255, 1);          // ENCRYPTION token
    let encOff = (pre[6] & 255) * 256 + (pre[7] & 255);
    assert.equalInt(pre[encOff] & 255, 2);     // ENCRYPT_NOT_SUP
}

@test
fn test_login7_shape(): void {
    let l = codec.buildLogin7("sa", "pw", "master");
    // first 4 bytes = total length (LE) == the whole buffer length.
    let total = (l[0] & 255) + (l[1] & 255) * 256 + (l[2] & 255) * 65536;
    assert.equalInt(total, l.length);
    // TDSVersion 0x74000004 at bytes [4..8) little-endian -> 04 00 00 74
    assert.equalInt(l[4] & 255, 4);
    assert.equalInt(l[7] & 255, 116);          // 0x74
}

@test
fn test_token_stream_row_decode(): void {
    // COLMETADATA (129): 3 cols — id INTN(4)=38/4, name NVARCHAR=231, price NUMERIC(10,2)=108/9/10/2
    let s = List<int>();
    push(s, 129); push(s, 3); push(s, 0);                       // token, count=3
    // col id: usertype(4) flags(2) INTN len4, name "id" (105,100)
    push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0);
    push(s, 38); push(s, 4);
    push(s, 2); push(s, 105); push(s, 0); push(s, 100); push(s, 0);
    // col name: NVARCHAR len(2)=100 + collation(5), name "nm" (110,109)
    push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0);
    push(s, 231); push(s, 100); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0);
    push(s, 2); push(s, 110); push(s, 0); push(s, 109); push(s, 0);
    // col price: NUMERICN len=9 prec=10 scale=2, name "pr" (112,114)
    push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0);
    push(s, 108); push(s, 9); push(s, 10); push(s, 2);
    push(s, 2); push(s, 112); push(s, 0); push(s, 114); push(s, 0);
    // ROW (209): id=42, name="hi", price=19.99 (mag 1999 = 207,7 LE; sign 1)
    push(s, 209);
    push(s, 4); push(s, 42); push(s, 0); push(s, 0); push(s, 0);
    push(s, 4); push(s, 0); push(s, 104); push(s, 0); push(s, 105); push(s, 0);
    push(s, 3); push(s, 1); push(s, 207); push(s, 7);
    // DONE (253): status(2), curcmd(2), rowcount(8)=1
    push(s, 253); push(s, 0); push(s, 0); push(s, 0); push(s, 0);
    push(s, 1); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0);

    let r = codec.decodeTokens(hx(s));
    assert.isTrue(r.ok);
    assert.equalInt(r.rs.rowCount(), 1);
    assert.equalInt(r.rs.colCount(), 3);
    let row = r.rs.row(0);
    assert.equalInt(row.getInt(0), 42);
    assert.equalStr(row.getText(1), "hi");
    assert.equalStr(`${row.getDecimal(2)}`, "19.99");   // exact decimal128, not f64
}

@test
fn test_error_rides_on_result(): void {
    // T1: a TDS ERROR token (decodeTokens -> r.ok=false, r.err=message) is now mapped onto the seam
    // result by query/exec/prepared instead of being buried in the tag or dropped.
    let e = db.DbError("", "Invalid object name 'nope'.");
    let rs = db.errorResult(e);
    assert.isTrue(rs.hasError());
    assert.equalStr(rs.err.message, "Invalid object name 'nope'.");
    assert.isTrue(db.errorExec(e).hasError());
    assert.isTrue(!db.ResultSet().hasError());
}

@test
fn test_guid_string_format(): void {
    // T3: UNIQUEIDENTIFIER 16 bytes {Data1(4 LE), Data2(2 LE), Data3(2 LE), Data4(8)} ->
    // canonical 8-4-4-4-12. Storage bytes 00 11 22 33 | 44 55 | 66 77 | 88 99 | aa bb cc dd ee ff.
    let g = bytes.alloc(16);
    let vals = List<int>();
    let hexpairs = "00112233445566778899aabbccddeeff";
    let i = 0;
    while (i < 16) {
        let hi = mssqlHexNib(hexpairs[i*2]); let lo = mssqlHexNib(hexpairs[i*2+1]);
        bytes.write_byte(g, i, hi*16 + lo); i = i + 1;
    }
    // Data1 reversed: 33221100, Data2 reversed: 5544, Data3 reversed: 7766, then 8899, aabbccddeeff.
    assert.equalStr(codec.guidToString(g as string), "33221100-5544-7766-8899-aabbccddeeff");
}
fn mssqlHexNib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 97 + 10; }
    return 0;
}

@test
fn test_attention_packet(): void {
    // T8: ATTENTION is an empty TDS message of type 6, EOM status, 8-byte header.
    let a = codec.buildAttention();
    assert.equalInt(a.length, 8);      // header only, no payload
    assert.equalInt(a[0], 6);          // packet type = ATTENTION
    assert.equalInt(a[1], 1);          // status = EOM
}

@test
fn test_chunk_large_message(): void {
    // T14: a message larger than the packet size splits into multiple TDS packets. payload 5000,
    // packetSize 512 -> maxData 504 -> ceil(5000/504) = 10 packets (9 x 504 + 1 x 464 remainder).
    let payload = bytes.alloc(5000);
    let i = 0;
    while (i < 5000) { bytes.write_byte(payload, i, i & 255); i = i + 1; }
    let out = codec.chunkTdsMessage(1, payload as string, 512);

    let pos = 0;
    let count = 0;
    let expectId = 1;
    let dataTotal = 0;
    let n = out.length;
    while (pos < n) {
        let ptype = out[pos] & 255;
        let status = out[pos + 1] & 255;
        let plen = (out[pos + 2] & 255) * 256 + (out[pos + 3] & 255);
        let pid = out[pos + 6] & 255;
        assert.equalInt(ptype, 1);            // same type on every packet
        assert.equalInt(pid, expectId);       // packetId increments 1,2,3,...
        let isLast = pos + plen >= n;
        if (isLast) {
            assert.equalInt(status, 1);       // EOM on the final packet
            assert.equalInt(plen, 8 + 464);   // remainder length (472)
        } else {
            assert.equalInt(status, 0);       // normal (not EOM)
            assert.equalInt(plen, 512);       // full packetSize
        }
        dataTotal = dataTotal + (plen - 8);
        pos = pos + plen;
        count = count + 1;
        expectId = expectId + 1;
    }
    assert.equalInt(count, 10);               // ceil(5000/504)
    assert.equalInt(dataTotal, 5000);         // all payload bytes carried
}

@test
fn test_chunk_single_packet(): void {
    // T14: a payload that fits emits ONE packet with EOM status and packetId 1.
    let payload = bytes.alloc(100);
    let i = 0;
    while (i < 100) { bytes.write_byte(payload, i, 65); i = i + 1; }
    let out = codec.chunkTdsMessage(1, payload as string, 4096);
    assert.equalInt(out.length, 108);          // one 8-byte header + 100 payload
    assert.equalInt(out[1] & 255, 1);          // EOM status
    assert.equalInt(out[6] & 255, 1);          // packetId 1
    let plen = (out[2] & 255) * 256 + (out[3] & 255);
    assert.equalInt(plen, 108);                // length covers the whole single packet
}

@test
fn test_status_byte_reset(): void {
    // T14: statusByte seam — EOM 0x01, RESETCONNECTION 0x08, combined 0x09.
    assert.equalInt(codec.statusByte(true, false), 0x01);   // EOM only
    assert.equalInt(codec.statusByte(true, true), 0x09);    // EOM + RESETCONNECTION
    assert.equalInt(codec.statusByte(false, true), 0x08);   // RESETCONNECTION only (not EOM)
    assert.equalInt(codec.statusByte(false, false), 0x00);  // normal
}

@test
fn test_reset_single_packet(): void {
    // T14: a reset-pending single-packet message carries EOM+RESETCONNECTION (0x09) on the one packet.
    let payload = bytes.alloc(100);
    let i = 0;
    while (i < 100) { bytes.write_byte(payload, i, 65); i = i + 1; }
    let out = codec.chunkTdsMessageReset(1, payload as string, 4096, true);
    assert.equalInt(out[1] & 255, 0x09);       // first (=last) packet: EOM | RESETCONNECTION
    assert.equalInt(out[6] & 255, 1);          // packetId 1
    // Without reset, the same payload is plain EOM (0x01) — no reset bit leaks in.
    let plain = codec.chunkTdsMessageReset(1, payload as string, 4096, false);
    assert.equalInt(plain[1] & 255, 0x01);
}

@test
fn test_reset_first_packet_only(): void {
    // T14: reset applies to the WHOLE message but is stamped on the FIRST packet only; the final
    // packet must still carry EOM (0x01) without the reset bit.
    let payload = bytes.alloc(5000);
    let i = 0;
    while (i < 5000) { bytes.write_byte(payload, i, 66); i = i + 1; }
    let out = codec.chunkTdsMessageReset(1, payload as string, 512, true);
    // First packet: RESETCONNECTION set, not EOM (more packets follow) -> 0x08.
    assert.equalInt(out[1] & 255, 0x08);
    assert.equalInt(out[6] & 255, 1);          // packetId 1
    // Walk to the final packet and confirm EOM without the reset bit.
    let pos = 0;
    let n = out.length;
    let lastStatus = 0;
    let secondStatus = -1;
    let seen = 0;
    while (pos < n) {
        let plen = (out[pos + 2] & 255) * 256 + (out[pos + 3] & 255);
        lastStatus = out[pos + 1] & 255;
        if (seen == 1) { secondStatus = out[pos + 1] & 255; }
        pos = pos + plen;
        seen = seen + 1;
    }
    assert.equalInt(secondStatus, 0x00);       // second (middle) packet: no reset, no EOM
    assert.equalInt(lastStatus, 0x01);         // final packet: EOM only, reset bit not repeated
}
