// mssql.nova — the Microsoft SQL Server driver SEAM: MssqlConnection (impl db.Connection) and
// MssqlDriver (impl db.Driver) over the TDS 7.4 protocol. This module orchestrates the connection
// lifecycle + the request/response loops; every other responsibility lives in its own module
// (SOLID/SRP):
//
//   connection      connection-string parsing         (ConnectionOptions, parse)
//   codec    the TDS wire codec                (build* frames + token/value decode, MsResult, MsPrep)
//   typemap  TDS type <-> DbType + value<->SQL  (mapDbType, msValueText, substituteParams)
//   proto    async transport framing           (TdsReader, readMessage, chanSend, sendRaw)
//   stmt     prepared-statement cache entry     (MsStmt)
//   auth     the LOGIN7 password obfuscation    (obfuscatePassword — used by codec.buildLogin7)
//
// MssqlConnection/MssqlDriver are the only names consumers touch: `import mssql; MssqlDriver()`.
//
//   let drv = MssqlDriver();
//   let conn = drv.connect("mssql://sa:Passw0rd@127.0.0.1:1433/master");
//   let rs = conn.query("SELECT id, name, price FROM t", List<DbValue>());
//   let id = rs.row(0).getInt(0);   // typed
//
// Flow: TCP connect → PRELOGIN (advertise ENCRYPT_NOT_SUP) → LOGIN7 (SQL auth, password nibble-swap
// +XOR obfuscation, UTF-16LE) → SQLBatch → token-stream decode (COLMETADATA / ROW / DONE / ERROR) →
// typed DbValue.
//
// TLS: the server here negotiates ENCRYPT_NOT_SUP, so login is cleartext. The TDS password
// OBFUSCATION (a fixed nibble-swap + XOR 0xA5, NOT encryption) is always applied. Full
// TLS-in-handshake (ENCRYPT_ON/REQ) + NTLM are deferred.
//
// The wire CODEC (frame build + token decode) is pure over byte buffers, gated offline
// (100_mssql_codec); connect/query wire it to a TcpStream, live-verified.
import net.aio;
import net.asynctls;
import net.tls12bio;
import net.tlsmembio;
import crypto.tls.truststore;
import io.file;
import bytes;
import string;
import list;
import db;
import connection;
import codec;
import typemap;
import proto;
import stmt;

// --- the seam implementation ---

pub struct MssqlConnection impl Connection {
    pub reader: TdsReader,
    pub stmts: List<MsStmt>,   // D6: server-side prepared-statement cache (sp_prepare handles)
    pub busy: bool,            // concurrency guard: one in-flight request per connection
    pub resetPending: bool,    // T14: a pool set this on reuse; next batch/RPC carries RESETCONNECTION
    pub failed: bool,          // set when connect/login/TLS failed: the connection is dead
    pub failErr: string,       // the failure reason surfaced to the first query/exec
    init(reader: TdsReader) {
        self.reader = reader;
        self.stmts = List<MsStmt>();
        self.busy = false;
        self.resetPending = false;
        self.failed = false;
        self.failErr = "";
    }
    // Mark this connection dead (login/TLS failure at connect). The first query/exec returns the reason
    // instead of pretending to be live, so a failed connect no longer looks successful to the caller.
    pub fn markFailed(self, why: string): void { self.failed = true; self.failErr = why; }

    // T14: a connection pool calls this when handing a reused connection back out. The next SQLBatch/RPC
    // this connection sends will carry the RESETCONNECTION (0x08) status bit, telling the server to reset
    // session state (SET options, temp tables, open transaction) before running it. Cleared on use.
    pub fn markForReset(self): void { self.resetPending = true; }

    // Consume the pending-reset flag: returns whether the next packet should carry RESETCONNECTION and
    // clears it so the reset applies to exactly one message.
    fn takeReset(self): bool {
        let r = self.resetPending;
        self.resetPending = false;
        return r;
    }
    pub async fn query(self, sql: string, params: List<DbValue>): ResultSet {
        if (self.failed) { return errorResult(DbError("", self.failErr)); }
        if (self.busy) { return errorResult(DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        // SECURITY: with params, bind them SERVER-SIDE via sp_executesql instead of interpolating into
        // the SQL text -- injection is then structurally impossible. No-param SQL keeps the SQLBatch path.
        let r = if (params.size() > 0) await self.runBound(sql, params)
                else await self.runBatch(sql);
        if (!r.ok) { r.rs.err = DbError("", r.err).with(r.errno, codec.classifyMssqlErr(r.errno)); }   // T1: surface the TDS ERROR token on the result
        self.busy = false;
        return r.rs;
    }
    async fn runBatch(self, sql: string): MsResult {
        let sn = await proto.chanSend(self.reader, codec.tdsPacketReset(codec.PKT_SQLBATCH, codec.buildSqlBatch(sql), self.takeReset()));
        let msg = await proto.readMessage(self.reader);
        return codec.decodeTokens(msg);
    }
    pub async fn exec(self, sql: string, params: List<DbValue>): ExecResult {
        if (self.failed) { return errorExec(DbError("", self.failErr)); }
        if (self.busy) { return errorExec(DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        // Same server-bound-param path as query() (see the SECURITY note there).
        let r = if (params.size() > 0) await self.runBound(sql, params)
                else await self.runBatch(sql);
        if (!r.ok) { self.busy = false; return errorExec(DbError("", r.err).with(r.errno, codec.classifyMssqlErr(r.errno))); }
        self.busy = false;
        return ExecResult(r.affected, "");
    }
    pub fn close(self): void {
        self.reader.io.close();   // TlsStream.close frees the TLS ctx; AsyncStream.close shuts the socket
    }

    // Transaction control (T-SQL). NOTE: these run as separate SQLBatch messages with the transaction
    // descriptor hardcoded 0 (see tdsPacket / buildSqlBatch), so a multi-batch transaction is not yet
    // bound to the server's descriptor -- ENVCHANGE(txn) tracking is a follow-on. Single-batch use is fine.
    pub async fn begin(self): ExecResult { return await self.exec("BEGIN TRANSACTION", List<DbValue>()); }
    pub async fn commit(self): ExecResult { return await self.exec("COMMIT TRANSACTION", List<DbValue>()); }
    pub async fn rollback(self): ExecResult { return await self.exec("ROLLBACK TRANSACTION", List<DbValue>()); }

    // Cancel the in-flight request on this connection by sending a TDS ATTENTION packet. The server
    // acknowledges with an attention token in the response stream; call from another coroutine on a deadline.
    pub async fn cancel(self): void { let _ = await proto.chanSend(self.reader, codec.buildAttention()); }

    pub fn setTimeout(self, ms: int): int {   // D6 — async per-recv awaited deadline (cleartext or TLS)
        return self.reader.io.setTimeout(ms);
    }

    // D6 prepared statements — REAL server-side (sp_prepare / sp_execute over TDS RPC). `prepare`
    // runs sp_prepare (server parses/plans the SQL, returns a handle) and caches it (deduped by
    // SQL); `queryPrepared`/`execPrepared` run sp_execute by handle with NVARCHAR-bound params.
    pub async fn prepare(self, sql: string): int {
        let d = 0;
        while (d < self.stmts.size()) {
            let s = self.stmts.get(d) ?? MsStmt(0, "");
            if (string.eql(s.sql, sql)) { return d; }
            d = d + 1;
        }
        let conv = codec.convertPlaceholders(sql);
        // sp_prepare(@handle OUTPUT, @params, @stmt, @options=1)
        let ps = codec.rpcParamIntN(true, 0)
            + codec.rpcParamNVarchar(codec.paramDecl(conv.nparams))
            + codec.rpcParamNVarchar(conv.sql)
            + codec.rpcParamIntN(false, 1);
        let _cs = await proto.chanSend(self.reader, codec.tdsPacket(codec.PKT_RPC, codec.buildRpc(codec.SP_PREPARE, ps)));
        let msg = await proto.readMessage(self.reader);
        let r = codec.decodeTokens(msg);
        if (!r.ok || r.retval == 0) { return -1; }
        let idx = self.stmts.size();
        self.stmts.push(MsStmt(r.retval, sql));
        return idx;
    }

    // sp_execute(@handle, @P1, @P2, ...): the handle INTN then each bound param as NVARCHAR.
    // One-shot server-bound execution via sp_executesql(@stmt, @params, @P1..@Pn). The param VALUES
    // ride in the RPC, never interpolated into the SQL text, so SQL injection is structurally
    // impossible. (Params bind as NVARCHAR today and rely on SQL Server implicit conversion; typed
    // binding is the Phase 2 follow-on. `$N`/`?` placeholders are rewritten to @PN by convertPlaceholders.)
    fn buildExecuteSqlRpc(self, sql: string, params: List<DbValue>): string {
        let conv = codec.convertPlaceholders(sql);
        let ps = codec.rpcParamNVarchar(conv.sql)
            + codec.rpcParamNVarchar(codec.paramDecl(conv.nparams));
        let i = 0;
        while (i < params.size()) {
            let p = params.get(i) ?? db.dbNull();
            if (p.isNull()) { ps = ps + codec.rpcParamNVarcharNull(); }
            else { ps = ps + codec.rpcParamNVarchar(typemap.msValueText(p)); }
            i = i + 1;
        }
        return codec.tdsPacketReset(codec.PKT_RPC, codec.buildRpc(codec.SP_EXECUTESQL, ps), self.takeReset());
    }
    async fn runBound(self, sql: string, params: List<DbValue>): MsResult {
        let _cs = await proto.chanSend(self.reader, self.buildExecuteSqlRpc(sql, params));
        let msg = await proto.readMessage(self.reader);
        return codec.decodeTokens(msg);
    }
    fn buildExecuteRpc(self, handle: long, params: List<DbValue>): string {
        let ps = codec.rpcParamIntN(false, handle);
        let i = 0;
        while (i < params.size()) {
            let p = params.get(i) ?? db.dbNull();
            if (p.isNull()) { ps = ps + codec.rpcParamNVarcharNull(); }
            else { ps = ps + codec.rpcParamNVarchar(typemap.msValueText(p)); }
            i = i + 1;
        }
        return codec.tdsPacketReset(codec.PKT_RPC, codec.buildRpc(codec.SP_EXECUTE, ps), self.takeReset());
    }

    pub async fn queryPrepared(self, stmt: int, params: List<DbValue>): ResultSet {
        if (self.busy) { return errorResult(DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        if (stmt < 0 || stmt >= self.stmts.size()) { self.busy = false; return ResultSet(); }
        let s = self.stmts.get(stmt) ?? MsStmt(0, "");
        let _cs = await proto.chanSend(self.reader, self.buildExecuteRpc(s.handle, params));
        let msg = await proto.readMessage(self.reader);
        let r = codec.decodeTokens(msg);
        if (!r.ok) { r.rs.err = DbError("", r.err).with(r.errno, codec.classifyMssqlErr(r.errno)); }   // T1: surface the TDS ERROR token
        self.busy = false;
        return r.rs;
    }

    pub async fn execPrepared(self, stmt: int, params: List<DbValue>): ExecResult {
        if (self.busy) { return errorExec(DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        if (stmt < 0 || stmt >= self.stmts.size()) { self.busy = false; return ExecResult(0, ""); }
        let s = self.stmts.get(stmt) ?? MsStmt(0, "");
        let _cs = await proto.chanSend(self.reader, self.buildExecuteRpc(s.handle, params));
        let msg = await proto.readMessage(self.reader);
        let r = codec.decodeTokens(msg);
        if (!r.ok) { self.busy = false; return errorExec(DbError("", r.err).with(r.errno, codec.classifyMssqlErr(r.errno))); }
        self.busy = false;
        return ExecResult(r.affected, "");
    }

    // Release a server-side prepared handle via sp_unprepare (ProcID 15) and drop it from the cache.
    // Frees the plan the matching prepare() reserved on the server. No-op for an out-of-range index.
    pub async fn dropPrepared(self, stmt: int): void {
        if (self.busy) { return; }
        if (stmt < 0 || stmt >= self.stmts.size()) { return; }
        self.busy = true;
        let s = self.stmts.get(stmt) ?? MsStmt(0, "");
        let _cs = await proto.chanSend(self.reader, codec.tdsPacket(codec.PKT_RPC, codec.buildUnprepare(s.handle)));
        let _msg = await proto.readMessage(self.reader);
        self.busy = false;
    }
}

// Copy `n` bytes of a raw buffer into a fresh Nova string.
fn msBufToStr(buf: ptr, n: int): string {
    if (n <= 0) { return ""; }
    let out = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(out, i, bytes.read_byte(buf, i)); i = i + 1; }
    return out as string;
}
// Read EXACTLY `n` bytes from the raw base stream into `buf` (a TDS-handshake helper). Parks.
async fn msReadN(base: aio.AsyncStream, buf: ptr, n: int): bool {
    let got = 0;
    while (got < n) {
        let r = await base.recvInto((buf + got) as int, n - got);
        if (r <= 0) { return false; }
        got = got + r;
    }
    return true;
}

// A1 async-first: the TDS-tunneled TLS handshake, fully non-blocking. wolfSSL (memory-BIO) does
// the crypto; this pump wraps each outbound TLS FLIGHT in ONE PRELOGIN (0x12) packet (SQL Server
// rejects a flight split across packets) and unwraps inbound PRELOGIN payloads back into wolfSSL —
// awaiting the socket throughout. After the handshake, TLS runs RAW over the socket (the plaintext
// is the TDS packets), so a plain asynctls.TlsStream (pure-Nova TLS 1.2 bio) carries the encrypted session. SQL Server ships
// a self-signed cert (drivers use TrustServerCertificate), so verification is off (a follow-on).
async fn tdsTlsHandshake(base: aio.AsyncStream, host: string, verify: bool, caPem: string): asynctls.TlsStream {
    let bio: tlsmembio.TlsBio = if (verify)
        tls12bio.newClient12BioVerify(host, truststore.loadPemBundle(caPem))
    else
        tls12bio.newClient12Bio(host);
    let cbuf = bytes.alloc(16384);
    let hbuf = bytes.alloc(8);
    let ok = false;
    while (true) {
        let st = bio.step();
        // Coalesce the whole outbound flight, then send it as ONE PRELOGIN packet.
        let flight = "";
        while (bio.pendingOut() > 0) {
            let pn = bio.pull(cbuf, 16384);
            if (pn <= 0) { break; }
            flight = flight + msBufToStr(cbuf, pn);
        }
        if (flight.length > 0) { let sn = await base.sendStr(codec.tdsPacket(codec.PKT_PRELOGIN, flight)); }
        if (st == 0) { ok = true; break; }   // handshake complete
        if (st < 0) { break; }               // handshake error
        // Read one inbound TDS packet (8-byte header + payload) and feed its payload to the bio.
        if (!(await msReadN(base, hbuf, 8))) { break; }
        let hi = bytes.read_byte(hbuf, 2) & 255;
        let lo = bytes.read_byte(hbuf, 3) & 255;
        let plen = hi * 256 + lo - 8;
        if (plen > 0) {
            let pbuf = bytes.alloc(plen);
            if (!(await msReadN(base, pbuf, plen))) { break; }
            bio.feed(pbuf as ptr, plen);
        }
    }
    bytes.free(cbuf);
    bytes.free(hbuf);
    let ts = asynctls.TlsStream(base, bio);
    // Report the REAL handshake outcome (was hardcoded true, so a failed tunneled handshake looked
    // successful). When `verify` is set (trustServerCertificate=false), the TLS 1.2 memory-BIO
    // VALIDATES the server certificate chain against `caPem` for `host` (tls12bio.trusts12) and fails
    // the handshake if it does not chain to a trusted root, so ts.ok() is false and msConnectAsync
    // fails the connection closed. With trustServerCertificate=true (the default for SQL Server's
    // self-signed cert) the chain is not checked. Callers MUST check ts.ok().
    ts.handshakeOk = ok;
    return ts;
}

// Whole connect (PRELOGIN → optional tunneled TLS → LOGIN7) as ONE async fn, driven once.
async fn msConnectAsync(connectionString: string): MssqlConnection {
    let d = connection.parse(connectionString);
    let base = await aio.asyncConnect(d.host, d.port);
    // PRELOGIN (cleartext) — advertise ON when the connection string asks for encryption, else NOT_SUP.
    let sn = await proto.sendRaw(base, codec.tdsPacket(codec.PKT_PRELOGIN, codec.buildPrelogin(d.encrypt)));
    let reader = TdsReader(base);        // reads PRELOGIN over the raw stream
    let pre = await proto.readMessage(reader);
    let serverEnc = codec.preloginEncryption(pre);
    // If we asked for encryption and the server did not decline it, tunnel the TLS handshake; every
    // packet from LOGIN7 on is then TLS-protected, and the reader's transport becomes the TlsStream.
    if (d.encrypt && serverEnc != 2) {   // 2 = ENCRYPT_NOT_SUP
        // Verify the server chain against tlsCAFile when trustServerCertificate=false; otherwise trust
        // it (SQL Server's default self-signed cert). A verify failure fails the handshake (ts.ok()).
        let verify = !d.trustCert;
        let caPem = if (verify && d.caFile != "") File.readText(d.caFile) else "";
        let ts = await tdsTlsHandshake(base, d.host, verify, caPem);
        if (!ts.ok()) {
            console.err("mssql: TLS handshake failed (cert not trusted?)");
            let dead = MssqlConnection(reader);
            dead.markFailed("mssql: TLS handshake failed (cert not trusted / not verifiable)");
            return dead;
        }
        reader.io = ts;
    }
    // LOGIN7 (obfuscated password; encrypted iff TLS is on)
    let ln = await proto.chanSend(reader, codec.tdsPacket(codec.PKT_LOGIN7, codec.buildLogin7(d.user, d.password, d.database)));
    let login = await proto.readMessage(reader);
    let lr = codec.decodeTokens(login);
    let conn = MssqlConnection(reader);
    if (!lr.ok) {
        console.err(`mssql login failed: ${lr.err}`);
        conn.markFailed(`mssql login failed: ${lr.err}`);
    }
    return conn;
}

pub struct MssqlDriver impl Driver {
    pub async fn connect(self, connectionString: string): Connection {
        return await msConnectAsync(connectionString);   // sync trait method drives the async connect once
    }
}
